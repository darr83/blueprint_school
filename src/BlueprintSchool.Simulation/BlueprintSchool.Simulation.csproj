<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Engine-independent game logic. Nothing in this project may reference Godot,
    so the whole simulation can be compiled and unit tested with plain `dotnet test`.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>BlueprintSchool.Simulation</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
